Cell[CellGroupData[{

Cell["\<\
Expectation value of (x, y, z) = (r sin(\[Theta]) cos(\[Phi]), r \
sin(\[Theta]) sin(\[Phi]), r cos(\[Theta]))\
\>", "Subsubsection",
 CellChangeTimes->{{3.985391802088369*^9, 3.985391849238761*^9}},
 FontSize->24,ExpressionUUID->"cc06484c-81f4-4191-bd99-79e735e26681"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", " ", 
   RowBox[{"<", "x", ">"}], " ", "*)"}], "\[IndentingNewLine]", 
  RowBox[{"Assuming", "[", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"Element", "[", 
      RowBox[{"t", ",", "Reals"}], "]"}], "}"}], ",", "\[IndentingNewLine]", 
    RowBox[{"Integrate", "[", "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{
       RowBox[{"r", "^", "2"}], 
       RowBox[{"Sin", "[", "\[Theta]", "]"}], "*", "\[IndentingNewLine]", "r",
        "*", 
       RowBox[{"Sin", "[", "\[Theta]", "]"}], "*", 
       RowBox[{"Cos", "[", "\[Phi]", "]"}], 
       RowBox[{
        RowBox[{"Abs", "[", 
         RowBox[{"psi82", "[", 
          RowBox[{"r", ",", "\[Theta]", ",", "\[CurlyPhi]", ",", "t"}], "]"}],
          "]"}], "^", "2"}]}], ",", "\[IndentingNewLine]", 
      RowBox[{"{", 
       RowBox[{"r", ",", "0", ",", "\[Infinity]"}], "}"}], ",", 
      RowBox[{"{", 
       RowBox[{"\[Theta]", ",", "0", ",", "\[Pi]"}], "}"}], ",", 
      RowBox[{"{", 
       RowBox[{"\[Phi]", ",", "0", ",", 
        RowBox[{"2", "\[Pi]"}]}], "}"}]}], "\[IndentingNewLine]", "]"}]}], 
   "\[IndentingNewLine]", "]"}]}]], "Input",
 CellChangeTimes->{{3.985391573738502*^9, 3.9853916566184273`*^9}, {
  3.98539171796496*^9, 3.9853917214848003`*^9}, {3.985392280861307*^9, 
  3.9853922875921497`*^9}},
 FontSize->18,
 CellLabel->"In[24]:=",ExpressionUUID->"84822e32-06f4-4b35-bfa8-87058d2b03fb"],

