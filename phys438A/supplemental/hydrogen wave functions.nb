Cell["\<\
The expectation value of the dipole moment is time dependent and oscillates \
with Bohr frequency.\
\>", "Text",
 CellChangeTimes->{{3.985424398761578*^9, 3.9854244330901327`*^9}},
 FontSize->24,ExpressionUUID->"ea35e83c-1a5c-45e0-ac1b-b8c6f56199c9"]
}, Open  ]]
}, Open  ]],

Cell[CellGroupData[{

Cell["Example 8.3, McIntyre", "Section",
 CellChangeTimes->{{3.985391889449041*^9, 3.985391893653113*^9}},
 FontSize->36,ExpressionUUID->"6d3f77fa-774f-443e-9c09-92a20ed4e852"],

Cell["\<\
Find the time evolution of an equal superposition of the 2s excited state and \
the 2p0 (m=0) excited state. This models a static electric dipole moment.\
\>", "Text",
 CellChangeTimes->{{3.985391913580121*^9, 3.985391964765913*^9}},
 FontSize->24,ExpressionUUID->"c1c818c2-8c36-43e4-b3e5-ba9c6480f138"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"psi83", "[", 
    RowBox[{"r_", ",", "\[Theta]_", ",", "\[Phi]_", ",", "t_"}], "]"}], ":=", 
   
   RowBox[{
    RowBox[{
     FractionBox["1", 
      SqrtBox["2"]], 
     RowBox[{"PSI", "[", 
      RowBox[{
      "2", ",", "0", ",", "0", ",", "r", ",", "\[Theta]", ",", "\[Phi]"}], 
      "]"}], 
     RowBox[{"Exp", "[", 
      FractionBox[
       RowBox[{
        RowBox[{"-", "I"}], " ", "t"}], 
       SuperscriptBox["2", "2"]], "]"}]}], "+", 
    RowBox[{
     FractionBox["1", 
      SqrtBox["2"]], 
     RowBox[{"PSI", "[", 
      RowBox[{
      "2", ",", "1", ",", "0", ",", "r", ",", "\[Theta]", ",", "\[Phi]"}], 
      "]"}], 
     RowBox[{"Exp", "[", 
      FractionBox[
       RowBox[{
        RowBox[{"-", "I"}], " ", "t"}], 
       SuperscriptBox["2", "2"]], "]"}]}]}]}], ";"}]], "Input",
 CellChangeTimes->{{3.9853919869039307`*^9, 3.985391996661984*^9}},
 FontSize->18,
 CellLabel->"In[27]:=",ExpressionUUID->"c0a37984-e2db-479f-a685-51b0b74a0efe"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"psi83XZ", "[", 
     RowBox[{"x_", ",", "z_", ",", "t_"}], "]"}], ":=", 
    RowBox[{"Module", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"r", ",", "\[Theta]", ",", "\[CurlyPhi]"}], "}"}], ",", 
      RowBox[{
       RowBox[{"r", "=", 
        RowBox[{"Sqrt", "[", 
         RowBox[{
          RowBox[{"x", "^", "2"}], "+", 
          RowBox[{"z", "^", "2"}]}], "]"}]}], ";", "\[IndentingNewLine]", 
       RowBox[{"\[Theta]", "=", 
        RowBox[{"If", "[", 
         RowBox[{
          RowBox[{"r", "==", "0"}], ",", "0", ",", 
          RowBox[{"ArcCos", "[", 
           RowBox[{"z", "/", "r"}], "]"}]}], "]"}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"\[CurlyPhi]", "=", 
        RowBox[{"If", "[", 
         RowBox[{
          RowBox[{"x", ">=", "0"}], ",", "0", ",", "Pi"}], "]"}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"psi83", "[", 
        RowBox[{"r", ",", "\[Theta]", ",", "\[CurlyPhi]", ",", "t"}], 
        "]"}]}]}], "]"}]}], ";"}], "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"vmax", "=", "0.005"}], ";"}], "   ", 
  RowBox[{"(*", 
   RowBox[{"tune", " ", "this"}], "*)"}]}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"gamma", "=", "0.4"}], ";"}], "    ", 
  RowBox[{"(*", " ", 
   RowBox[{"<", 
    RowBox[{"1", " ", "increases", " ", "contrast"}]}], "*)"}], "\n"}], "\[IndentingNewLine]", 
 RowBox[{"DensityPlot", "[", 
  RowBox[{
   RowBox[{"With", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"val", "=", 
       RowBox[{
        RowBox[{"Abs", "[", 
         RowBox[{"psi83XZ", "[", 
          RowBox[{"x", ",", "z", ",", "0"}], "]"}], "]"}], "^", "2"}]}], 
      "}"}], ",", 
     RowBox[{
      RowBox[{"(", 
       RowBox[{"Rescale", "[", 
        RowBox[{
         RowBox[{"Log", "[", 
          RowBox[{"1", "+", "val"}], "]"}], ",", 
         RowBox[{"{", 
          RowBox[{"0", ",", 
           RowBox[{"Log", "[", 
            RowBox[{"1", "+", "vmax"}], "]"}]}], "}"}]}], "]"}], ")"}], "^", 
      "gamma"}]}], "]"}], ",", 
   RowBox[{"{", 
    RowBox[{"x", ",", 
     RowBox[{"-", "10"}], ",", "10"}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{"z", ",", 
     RowBox[{"-", "10"}], ",", "10"}], "}"}], ",", 
   RowBox[{"ColorFunction", "->", "\"\<GrayTones\>\""}], ",", 
   RowBox[{"ColorFunctionScaling", "->", "False"}], ",", 
   RowBox[{"PlotPoints", "->", "80"}], ",", 
   RowBox[{"PlotRange", "->", 
    RowBox[{"{", 
     RowBox[{"0", ",", "5"}], "}"}]}], ",", 
   RowBox[{"FrameLabel", "->", 
    RowBox[{"{", 
     RowBox[{"\"\<x\>\"", ",", "\"\<z\>\""}], "}"}]}], ",", 
   RowBox[{"BaseStyle", "->", "18"}], ",", 
   RowBox[{"ImageSize", "->", "500"}]}], "]"}]}], "Input",
 CellChangeTimes->{{3.9853920198850718`*^9, 3.985392044064494*^9}},
 FontSize->18,
 CellLabel->"In[28]:=",ExpressionUUID->"f662824b-1d85-4846-821d-b8bebf3e6364"],

