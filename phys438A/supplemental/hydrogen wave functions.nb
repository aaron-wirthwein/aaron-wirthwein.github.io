Cell[TextData[StyleBox["Find the time evolution of an equal superposition of \
the 1s ground state and the 2p0 (m=0) excited state. This models an \
oscillating electric dipole moment.",
 FontSize->24]], "Text",
 CellChangeTimes->{{3.985389074022583*^9, 3.985389101941193*^9}, {
  3.98539142330685*^9, 3.9853914313470373`*^9}},
 FontSize->24,ExpressionUUID->"2f0a148e-63df-4af4-bbc8-bac0eab523a5"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"psi82", "[", 
    RowBox[{"r_", ",", "\[Theta]_", ",", "\[Phi]_", ",", "t_"}], "]"}], ":=", 
   
   RowBox[{
    RowBox[{
     FractionBox["1", 
      SqrtBox["2"]], 
     RowBox[{"PSI", "[", 
      RowBox[{
      "1", ",", "0", ",", "0", ",", "r", ",", "\[Theta]", ",", "\[Phi]"}], 
      "]"}], 
     RowBox[{"Exp", "[", 
      FractionBox[
       RowBox[{
        RowBox[{"-", "I"}], " ", "t"}], 
       SuperscriptBox["1", "2"]], "]"}]}], "+", 
    RowBox[{
     FractionBox["1", 
      SqrtBox["2"]], 
     RowBox[{"PSI", "[", 
      RowBox[{
      "2", ",", "1", ",", "0", ",", "r", ",", "\[Theta]", ",", "\[Phi]"}], 
      "]"}], 
     RowBox[{"Exp", "[", 
      FractionBox[
       RowBox[{
        RowBox[{"-", "I"}], " ", "t"}], 
       SuperscriptBox["2", "2"]], "]"}]}]}]}], ";"}]], "Input",
 CellChangeTimes->{{3.985389142641644*^9, 3.9853892497286263`*^9}},
 FontSize->18,
 CellLabel->"In[18]:=",ExpressionUUID->"963eb897-fa63-4eab-ac75-c64ecb3f2e9a"],

Cell[CellGroupData[{

Cell["\<\
Convert to Cartesian coordinates to create density plot in x-z plane\
\>", "Subsubsection",
 CellChangeTimes->{{3.9853905336172657`*^9, 3.985390556995646*^9}},
 FontSize->24,ExpressionUUID->"68ae919e-fc6a-46ae-93b3-025c5b558574"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"psiXZ", "[", 
    RowBox[{"x_", ",", "z_", ",", "t_"}], "]"}], ":=", 
   RowBox[{"Module", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"r", ",", "\[Theta]", ",", "\[CurlyPhi]"}], "}"}], ",", 
     RowBox[{
      RowBox[{"r", "=", 
       RowBox[{"Sqrt", "[", 
        RowBox[{
         RowBox[{"x", "^", "2"}], "+", 
         RowBox[{"z", "^", "2"}]}], "]"}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"\[Theta]", "=", 
       RowBox[{"If", "[", 
        RowBox[{
         RowBox[{"r", "==", "0"}], ",", "0", ",", 
         RowBox[{"ArcCos", "[", 
          RowBox[{"z", "/", "r"}], "]"}]}], "]"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"\[CurlyPhi]", "=", 
       RowBox[{"If", "[", 
        RowBox[{
         RowBox[{"x", ">=", "0"}], ",", "0", ",", "Pi"}], "]"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"psi82", "[", 
       RowBox[{"r", ",", "\[Theta]", ",", "\[CurlyPhi]", ",", "t"}], 
       "]"}]}]}], "]"}]}], ";"}]], "Input",
 CellChangeTimes->{{3.9853896011360197`*^9, 3.985389611171427*^9}},
 FontSize->18,
 CellLabel->"In[19]:=",ExpressionUUID->"e35f3a72-9b2e-4aee-8020-a2b9a51c0670"]
}, Open  ]],

Cell[CellGroupData[{

Cell["Plot Abs[psi]^2 with rescaling for good contrast", "Subsubsection",
 CellChangeTimes->{{3.985390517030836*^9, 3.9853905253418827`*^9}, {
  3.985391162204867*^9, 3.9853911756998787`*^9}},
 FontSize->24,ExpressionUUID->"e27dff83-e121-4549-bc12-a685bcd6cf9c"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"vmax", "=", "0.005"}], ";"}], "   ", 
  RowBox[{"(*", 
   RowBox[{"tune", " ", "this"}], "*)"}]}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"gamma", "=", "0.4"}], ";"}], "    ", 
  RowBox[{"(*", " ", 
   RowBox[{"<", 
    RowBox[{"1", " ", "increases", " ", "contrast"}]}], "*)"}], "\n"}], "\[IndentingNewLine]", 
 RowBox[{"DensityPlot", "[", 
  RowBox[{
   RowBox[{"With", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"val", "=", 
       RowBox[{
        RowBox[{"Abs", "[", 
         RowBox[{"psiXZ", "[", 
          RowBox[{"x", ",", "z", ",", "0"}], "]"}], "]"}], "^", "2"}]}], 
      "}"}], ",", 
     RowBox[{
      RowBox[{"(", 
       RowBox[{"Rescale", "[", 
        RowBox[{
         RowBox[{"Log", "[", 
          RowBox[{"1", "+", "val"}], "]"}], ",", 
         RowBox[{"{", 
          RowBox[{"0", ",", 
           RowBox[{"Log", "[", 
            RowBox[{"1", "+", "vmax"}], "]"}]}], "}"}]}], "]"}], ")"}], "^", 
      "gamma"}]}], "]"}], ",", 
   RowBox[{"{", 
    RowBox[{"x", ",", 
     RowBox[{"-", "10"}], ",", "10"}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{"z", ",", 
     RowBox[{"-", "10"}], ",", "10"}], "}"}], ",", 
   RowBox[{"ColorFunction", "->", "\"\<GrayTones\>\""}], ",", 
   RowBox[{"ColorFunctionScaling", "->", "False"}], ",", 
   RowBox[{"PlotPoints", "->", "80"}], ",", 
   RowBox[{"PlotRange", "->", 
    RowBox[{"{", 
     RowBox[{"0", ",", "5"}], "}"}]}], ",", 
   RowBox[{"FrameLabel", "->", 
    RowBox[{"{", 
     RowBox[{"\"\<x\>\"", ",", "\"\<z\>\""}], "}"}]}], ",", 
   RowBox[{"BaseStyle", "->", "18"}], ",", 
   RowBox[{"ImageSize", "->", "500"}]}], "]"}]}], "Input",
 CellChangeTimes->{{3.985390860675501*^9, 3.985391045390679*^9}, {
  3.9853913323654203`*^9, 3.985391355220389*^9}},
 FontSize->18,
 CellLabel->"In[20]:=",ExpressionUUID->"c1baac52-6420-4397-b45e-84a6b8bef5eb"],

