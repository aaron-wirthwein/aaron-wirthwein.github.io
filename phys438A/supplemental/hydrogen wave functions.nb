 RowBox[{
  RowBox[{"nn", "=", "1"}], ";", 
  RowBox[{"ll", "=", "0"}], ";", 
  RowBox[{"mm", "=", "0"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{"NIntegrate", "[", "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{"r", "^", "2"}], 
    RowBox[{"Sin", "[", "\[Theta]", "]"}], "*", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"Abs", "[", 
      RowBox[{"PSI", "[", 
       RowBox[{
       "nn", ",", "ll", ",", "mm", ",", "r", ",", "\[Theta]", ",", "\[Phi]"}],
        "]"}], "]"}], "^", "2"}]}], ",", "\[IndentingNewLine]", 
   RowBox[{"{", 
    RowBox[{"r", ",", "0", ",", "1"}], "}"}], ",", 
   RowBox[{"{", 
