Cell[CellGroupData[{

Cell[TextData[StyleBox["Hydrogen Wave Functions",
 FontSize->36]], "Section",
 CellChangeTimes->{{3.98538815379953*^9, 3.985388161765985*^9}},
 FontSize->18,ExpressionUUID->"cafea21a-0151-4f21-80fe-76bc2b70f989"],

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"Y", "[", 
    RowBox[{"l_", ",", "m_", ",", "\[Theta]_", ",", "\[Phi]_"}], "]"}], ":=", 
   
   RowBox[{"SphericalHarmonicY", "[", 
    RowBox[{"l", ",", "m", ",", "\[Theta]", ",", "\[Phi]"}], "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"R", "[", 
    RowBox[{"n_", ",", "l_", ",", "r_"}], "]"}], ":=", 
   RowBox[{
    SqrtBox[
     RowBox[{
      SuperscriptBox[
       RowBox[{"(", 
        FractionBox["2", "n"], ")"}], "3"], 
      FractionBox[
       RowBox[{
        RowBox[{"(", 
         RowBox[{"n", "-", "l", "-", "1"}], ")"}], "!"}], 
       RowBox[{"2", "n", 
        RowBox[{
         RowBox[{"(", 
          RowBox[{"n", "+", "l"}], ")"}], "!"}]}]]}]], 
    SuperscriptBox[
     RowBox[{"(", 
      FractionBox[
       RowBox[{"2", "r"}], "n"], ")"}], "l"], 
    RowBox[{"LaguerreL", "[", 
     RowBox[{
      RowBox[{"n", "-", "l", "-", "1"}], ",", 
      RowBox[{
       RowBox[{"2", "l"}], "+", "1"}], ",", 
      RowBox[{"2", 
       RowBox[{"r", "/", "n"}]}]}], "]"}], 
    RowBox[{"Exp", "[", 
     RowBox[{
      RowBox[{"-", "r"}], "/", "n"}], "]"}]}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"PSI", "[", 
    RowBox[{
    "n_", ",", "l_", ",", "m_", ",", "r_", ",", "\[Theta]_", ",", "\[Phi]_"}],
     "]"}], ":=", 
   RowBox[{
    RowBox[{"R", "[", 
     RowBox[{"n", ",", "l", ",", "r"}], "]"}], "*", 
    RowBox[{"Y", "[", 
     RowBox[{"l", ",", "m", ",", "\[Theta]", ",", "\[Phi]"}], "]"}]}]}], 
  ";"}]}], "Input",
 CellChangeTimes->{{3.985388179289714*^9, 3.98538819047617*^9}, {
  3.985388249189145*^9, 3.985388368389679*^9}},
 FontSize->18,
 CellLabel->"In[3]:=",ExpressionUUID->"0bcbb819-7d90-4757-8380-2e6bd6f5d590"],

