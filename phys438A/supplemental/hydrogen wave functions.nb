Cell[CellGroupData[{

Cell[TextData[StyleBox["Example 8.1, McIntyre",
 FontSize->36]], "Section",
 CellChangeTimes->{{3.985388858111133*^9, 3.985388864935217*^9}},
 FontSize->18,ExpressionUUID->"02366272-4b5f-47d5-87cf-00e09aec4550"],

Cell[TextData[{
 "Find the probability that the electron in the ",
 StyleBox["ground state",
  FontColor->RGBColor[0, 0.74, 0.74]],
 " of hydrogen is measured to be within one Bohr radius of the nucleus and \
calculate the expectation value of the radial position r."
}], "Text",
 CellChangeTimes->{{3.985388874864456*^9, 3.985388877293024*^9}},
 FontSize->24,ExpressionUUID->"b586d879-aae3-40e6-bc3f-c0a80fb37ec6"],

