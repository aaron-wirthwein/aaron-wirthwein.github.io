Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"DensityPlot", "[", 
  RowBox[{
   RowBox[{"With", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"val", "=", 
       RowBox[{
        RowBox[{"Abs", "[", 
         RowBox[{"psiXZ", "[", 
          RowBox[{"x", ",", "z", ",", 
           RowBox[{"4", 
            RowBox[{"Pi", "/", "3"}]}]}], "]"}], "]"}], "^", "2"}]}], "}"}], ",", 
     RowBox[{
      RowBox[{"(", 
       RowBox[{"Rescale", "[", 
        RowBox[{
         RowBox[{"Log", "[", 
          RowBox[{"1", "+", "val"}], "]"}], ",", 
         RowBox[{"{", 
          RowBox[{"0", ",", 
           RowBox[{"Log", "[", 
            RowBox[{"1", "+", "vmax"}], "]"}]}], "}"}]}], "]"}], ")"}], "^", 
      "gamma"}]}], "]"}], ",", 
   RowBox[{"{", 
    RowBox[{"x", ",", 
     RowBox[{"-", "10"}], ",", "10"}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{"z", ",", 
     RowBox[{"-", "10"}], ",", "10"}], "}"}], ",", 
   RowBox[{"ColorFunction", "->", "\"\<GrayTones\>\""}], ",", 
   RowBox[{"ColorFunctionScaling", "->", "False"}], ",", 
   RowBox[{"PlotPoints", "->", "80"}], ",", 
   RowBox[{"PlotRange", "->", 
    RowBox[{"{", 
     RowBox[{"0", ",", "5"}], "}"}]}], ",", 
   RowBox[{"FrameLabel", "->", 
    RowBox[{"{", 
     RowBox[{"\"\<x\>\"", ",", "\"\<z\>\""}], "}"}]}], ",", 
   RowBox[{"BaseStyle", "->", "18"}], ",", 
   RowBox[{"ImageSize", "->", "500"}]}], "]"}]], "Input",
